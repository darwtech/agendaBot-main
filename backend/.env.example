NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agendabot_db
DB_USER=postgres
DB_PASSWORD=

FRONTEND_URL=http://localhost:5173

# Zona horaria por defecto de los negocios nuevos (IANA)
BUSINESS_TIMEZONE=Europe/Madrid

# deepseek | gemini | groq  (reservado para el módulo de IA en servidor)
AI_PROVIDER=groq
AI_TIMEOUT_MS=15000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Reservado para el módulo de WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_PATH=./sessions/whatsapp
WHATSAPP_ALLOWED_NUMBERS=

# Token de la API de plataforma (alta de negocios). Vacío = deshabilitada.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Cada negocio tiene su propio token de panel: npm run tenant:create / tenant:token
PLATFORM_TOKEN=
