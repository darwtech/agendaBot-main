# URL base de la API. Usa "/api" con el proxy de Vite en desarrollo,
# o una URL absoluta (https://api.tudominio.com) en producción.
VITE_API_URL=/api

# Backend al que el servidor de desarrollo de Vite redirige /api (solo dev).
VITE_API_PROXY_TARGET=http://localhost:3000

# "local" = modo demo con datos en el navegador. "api" = cargar y guardar en el backend.
VITE_DATA_SOURCE=local

# Negocio al que redirige la portada (/) en modo API. Vacío = pide elegir negocio.
VITE_DEFAULT_TENANT=
